<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
        <br>
    <h3>Create a new posting</h3>
    <form method="POST" action="/postings" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="posting[title]" placeholder="enter title" type="text" class="form-control" required>
            <div class="invalid-feedback">please enter title!</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">description</label>
            <textarea name="posting[description]" placeholder="Enter description" class="form-control" required></textarea>
            <div class="invalid-feedback">Give a short description</div>
        </div> 
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input name="posting[image]" type="file" class="form-control" required>
        </div>
        <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="posting[price]" placeholder="1500" class="form-control" required>
            <div class="invalid-feedback">please enter price!</div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">country</label>
            <input name="posting[country]" placeholder="India" type="text" class="form-control" required>
            <div class="invalid-feedback">please enter valid country</div>
        </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="posting[location]" placeholder="Hyderabad" type="text" class="form-control" required>
            <div class="invalid-feedback">please enter valid location</div>
        </div>
        <button class="btn btn-dark add-btn">Add</button>
        <br><br>
    </form>
        </div>
    </div>
</body>